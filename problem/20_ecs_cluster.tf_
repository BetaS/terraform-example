resource "aws_ecs_cluster" "cluster" {
  name = var.name
}

# Fargate가 이미지 pull, CloudWatch Logs 전송 등에 사용하는 역할
resource "aws_iam_role" "execution_role" {
  name = "ecsTaskExecutionRole-${var.name}"
  assume_role_policy = # TODO: data에 정의된 내용을 json으로 불러오기
}

resource "aws_iam_role_policy_attachment" "execution_role" {
  role       = aws_iam_role.execution_role.name
  policy_arn = # TODO: AWS에서 이미 정의된 AmazonECSTaskExecutionRolePolicy 를 그대로 붙여 줄 예정
}
