resource "aws_cloudfront_distribution" "main" {
  provider = # TODO: 앞서 정의한 global 프로바이더 사용
  # 힌트: CloudFront는 us-east-1 쪽 alias provider 사용

  origin {
    # Cloudfront가 ALB를 오리진으로 사용하도록 설정 -> alb의 dns_name을 사용
    domain_name = # TODO: ALB의 DNS 이름 불러오기
    # 힌트: 11_alb.tf에서 정의할 ALB 리소스의 dns_name 속성을 참조
    origin_id   = "internalALB"

    custom_origin_config {
      origin_protocol_policy = "https-only"
      http_port              = 80
      https_port             = 443
      origin_ssl_protocols   = ["TLSv1.2"]
    }
  }

  enabled             = true
  default_root_object = "index.html"
  # 200 class -> 100, 200, 300 3가지가 존재
  # 100 class -> 미국, 유럽 -> 제일 쌈, 한국에서 테스트할때 쪼금 느리다는 문제, 개발 환경 100
  # 200 class -> 미국, 유럽, 아시아 (한국 포함), 가장 밸런스 좋은 형태, 운영 환경에서는 200
  # 300 class -> 미국, 유럽, 아시아, 남미, 아프리카 -> 제일 비쌈
  price_class         = "PriceClass_200"
  http_version        = "http2"

  default_cache_behavior {
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]
    target_origin_id       = "internalALB"
    viewer_protocol_policy = "redirect-to-https"

    forwarded_values {
      query_string = true

      cookies {
        forward = "all"
      }
    }
  }

  # 참고: API의 경우의 특정 METHOD (ex: POST, PUT 등) 및 PATH 에 대해서 캐시를 수행하는 경우 문제가 발생 할 가능성이 높음
  # 웹과 API를 함께 서비스하려면 `/api/*` 경로를 별도 behavior로 분리하는 방법을 고민해볼 것
  # 우리 예제에서는 간단한 어플리케이션 이므로 굳이 수행하지 않아도 문제없음

  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }

  viewer_certificate {
    cloudfront_default_certificate = true
  }

  tags = {
    Name = "${var.name}-cloudfront"
  }
}
