locals {
  api_port = 7777
}

# 힌트: 여기 일부 리소스는 Terraform 블록 문법 자체를 직접 완성해야 함
resource aws_cloudwatch_log_group "api-server" {
  name              = "/ecs/${var.name}-api-server"
  retention_in_days = 7
  tags = {
    Name        = "${var.name}-api-server"
  }
}

resource "aws_ecr_repository" "api-server" {
  name = "${var.name}-api-server"
  image_tag_mutability = "MUTABLE"
  force_delete = true
  image_scanning_configuration {
    scan_on_push = false
  }
}

resource "aws_ecs_task_definition" "api-server" {
  family = "${var.name}-api-server"
  network_mode = "awsvpc"
  cpu = # TODO: 0.5vCPU
  memory = # TODO: 1GB RAM
  lifecycle {
    ignore_changes = [container_definitions]
  }
  runtime_platform {
    # 참고 arm64의 경우 graviton인스턴스가 선택되어 가장 저렴하지만, 별도 build runner를 돌려야 하므로 예제의 경우에는 x86_64를 권장
    cpu_architecture = # TODO: x86_64, ARM64 중 선택
    operating_system_family = "LINUX"
  }
  requires_compatibilities = ["FARGATE"]
  task_role_arn = # TODO: 해당 서비스를 위한 TASK ROLE ARN 지정
  execution_role_arn = # TODO: 해당 서비스를 위한 TASK EXECUTION ROLE ARN 지정
  
  # task_role: 컨테이너 앱이 AWS API 호출 시 사용
  # execution_role: ECS가 이미지 pull·로그·시크릿 주입 등 플랫폼 유지보수를 위한 작업 시 사용

  # 참고: docker 이미지 정의를 기반으로 수정해야한다.
  container_definitions = jsonencode([
    {
      name         = "${var.name}-api-server"
      image        = "${aws_ecr_repository.api-server.repository_url}:latest"
      networkMode  = "awsvpc"
      portMappings = [
        {
          name          = "http",
          containerPort = local.api_port,
          hostPort      = local.api_port,
          protocol      = "tcp",
          appProtocol   = "http"
        }
      ]
      environment = [
        {
          name  = "RDS_SECRET_ARN"
          value = aws_secretsmanager_secret.rds.arn
        }
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.api-server.name
          "awslogs-region"        = "ap-northeast-2"
          "awslogs-stream-prefix" = "ecs"
        }
      }
    }])
}

resource "aws_ecs_service" "api-server" {
  name = "${var.name}-api-server"

  # TODO: ECS 서비스 생성
  # 1. 클러스터에 연결하고
  # 2. 태스크 정의와 연결하고
  # 3. 원하는 갯수 (일단 0개)만큼 실행하고
  # 4. 네트워크 설정을 해주고
  # 5. 로드밸런서와 연결하고
  # 6. 용량 전략(FARGATE_SPOT)을 설정한다.
  # 힌트: ecs_service에서 자주 쓰는 상위 속성과 nested block을 직접 찾아서 조합
  cluster = # TODO: 앞서 정의한 ecs cluster 지정
  task_definition = # TODO: 앞서 정의한 task definition 지정
  desired_count = # TODO: 처음에는 ECR 배포 안되었 0개로 시작, CI/CD 성공 이후 1개 이상으로 변경
  # ignore_changes에 desired_count가 등록되어, 실제로는 AWS콘솔(웹)에서 해줘야함

  network_configuration {
    subnets = # TODO: private subnet 전체에 걸쳐서 배포
    security_groups = [aws_security_group.api-server.id]
    assign_public_ip = false
  }

  load_balancer {
    container_name = # TODO: task_definition내의 container name 등록
    container_port = # TODO: task_definition내의 container port 등록
    target_group_arn = aws_lb_target_group.api-server.arn
  }

  deployment_circuit_breaker {
    enable   = true
    rollback = true
  }

  capacity_provider_strategy {
    capacity_provider = # TODO: FARGATE_SPOT 타입으로 지정
    weight = 1
  }

  lifecycle {
    ignore_changes = [task_definition, desired_count]
  }
}

resource aws_security_group "api-server" {
  name   = "ecs-task-${var.name}-api-server-sg"
  vpc_id = aws_vpc.main.id

  # TODO: ALB -> API ECS 태스크에 들어오는 tcp 트래픽을 허용
  # 힌트: ingress는 ALB SG에서 api_port로
  
  # TODO: ECS -> http / https egress 요청을 허용 해야, ecr pull, 외부 리소스 호출 등이 가능

  # TODO: ECS -> rds egress요청 허용 필요, postgres는 5432 (30_rds에서 정의해도 좋음)

  tags   = {
      Name = "ecs-task-${var.name}-api-server-sg"
  }
}

resource "aws_security_group_rule" "lb_to_api_server_egress" {
  security_group_id = aws_security_group.alb.id
  # TODO: ALB에서 API ECS 태스크로의 tcp 트래픽 egress을 허용
  # 힌트: SG rule 리소스에서는 어떤 SG를 기준으로 규칙을 추가하는지와 반대편 SG를 잘 구분
}

resource "aws_lb_target_group" "api-server" {
  name                  = "alb-tg-${var.name}-api-server"

  port = # TODO: ecs task의 listen port
  protocol = "HTTP"
  vpc_id = aws_vpc.main.id
  target_type = "ip"
  deregistration_delay = # TODO: deregistration delay 설정 (30s로 설정해야 spot instance가 SIGTERM을 받았을 때, 컨테이너가 종료되기 전에 ALB에서 먼저 제거되도록 설정)

  health_check {
    interval            = 120
    path                = # TODO: health check 경로 (web: /, api: /api/check)
    timeout             = 60
    matcher             = # TODO: HTTP코드 2xx를 허용
    healthy_threshold   = 5
    unhealthy_threshold = 5
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource aws_lb_listener_rule "api-server" {
  listener_arn = aws_lb_listener.main.arn
  priority     = # TODO: LB 규칙 적용 우선순위 지정, 숫자가 클 수록 나중에 적용

  # TODO: 특정 경로 (/api/*) 일때 ALB -> API ECS 태스크로의 tcp 트래픽 forward 설정
  # 힌트: action 블록은 target group으로 forward, condition 블록은 path_pattern 사용
  action {
    type = "forward"
    target_group_arn = aws_lb_target_group.api-server.arn
  }

  condition {
    path_pattern {
      values = # TODO: 특정 경로를 해당 컨테이너로 라우팅 (ex: {/api/, /api/*} -> api, {/, /*} -> web)
    }
  }
}

resource "aws_iam_role" "task_role_api" {
  name = "ecsTaskRole-${var.name}-api"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ecs-tasks.amazonaws.com"
        }
      }
    ]
  })
}
