# 프라이빗 서브넷: AZ마다 하나씩 두고, VPC CIDR 안에서 public과 겹치지 않는 대역을 쓴다.
resource "aws_subnet" "private" {
  count = # TODO: var.zones 개수만큼 서브넷을 만든다

  vpc_id = # TODO: 이 서브넷이 속할 VPC ID

  cidr_block = # TODO: VPC CIDR을 쪼개 private용 블록 지정 (public과 겹치지 않게)
  
  availability_zone = # TODO: count.index에 해당하는 AZ 이름
  
  map_public_ip_on_launch = # TODO: private 서브넷이면 퍼블릭 IP 가 할당 되어야 할까? true / false

  tags = {
    Name = "${var.name}-subnet-private-${count.index}"
  }
}

# private 서브넷은 VPC 기본(main) 라우트 테이블을 쓰면 IGW로 나가며 의도와 어긋날 수 있어,
# AZ마다 전용 라우트 테이블을 두고 NAT로만 아웃바운드를 보내는 구성이 일반적이다.
resource "aws_route_table" "private_route_table" {
  count  = # TODO: private 서브넷(또는 AZ) 개수와 동일하게
  vpc_id = # TODO: 라우트 테이블이 속할 VPC ID

  tags = {
    Name = "${var.name}-route-table-private-${count.index}"
  }
}

# 각 private 서브넷을 자기 AZ의 private 라우트 테이블에 연결한다.
resource "aws_route_table_association" "route_table_association_private" {
  count = # TODO: 서브넷·라우트 테이블과 같은 개수

  subnet_id      = # TODO: 같은 count.index의 private 서브넷 ID
  route_table_id = # TODO: 같은 count.index의 private 라우트 테이블 ID
}

# private에서 인터넷으로 나갈 때는 같은 AZ의 NAT Gateway로 기본 경로를 보낸다.
resource "aws_route" "private_nat_route" {
  count = # TODO: 라우트 테이블 개수와 동일

  route_table_id         = # TODO: 같은 인덱스의 private 라우트 테이블 ID
  destination_cidr_block = # TODO: 인터넷으로 나가는 default route 경로

  nat_gateway_id = # TODO: 같은 AZ(같은 count.index)의 NAT Gateway ID
}
