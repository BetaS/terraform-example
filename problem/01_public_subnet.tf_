resource "aws_subnet" "public" {
  count = # TODO: var.zones 를 순회하며 public subnet을 생성
  vpc_id = # TODO: 00_vpc.tf 에서 정의된 
  cidr_block = # TODO: count를 순회하며 갯수만큼 cidr block을 만들어 줘야 함

  availability_zone       = # TODO: var.zones 에서 count.index에 해당하는 zone name을 가져온다.
  map_public_ip_on_launch = # TODO: public subnet일때는 어떤 옵션으로 해야할까? true / false

  tags = {
    Name = "${var.name}-subnet-public-${count.index}"
  }
}

resource "aws_route_table_association" "public" {
  # TODO: public 서브넷에 vpc default routing table을 연결
  # 힌트: 같은 count를 사용하고 subnet_id와 default route table id를 연결
}