resource "aws_security_group" "rds" {
  name   = "${var.name}-rds-sg"
  vpc_id = aws_vpc.main.id

  # aws_security_group.ecs_api_rds_client 에서 aws_security_group.rds의 sg_id를 참조
  # 반면, aws_security_group.rds에서도 aws_security_group.ecs_api_rds_client 의 sg_id를 참조 하게 되면 
  # cycle dependency 문제가 발생 하는데, 어떻게 해결 할 수 있을까?
  # ingress {
  #   from_port       = aws_db_instance.rds.port
  #   to_port         = aws_db_instance.rds.port
  #   protocol        = "tcp"
  #   security_groups = [aws_security_group.ecs_api_rds_client.id]
  # }

  tags = {
    Name = "${var.name}-rds-sg"
  }
}

resource "aws_security_group_rule" "rds_to_api_ingress" {
  type            = # TODO: ingress / egress 지정
  from_port       = # TODO: db포트
  to_port         = # TODO: db포트
  protocol        = "tcp"

  security_group_id = # TODO: RDS의 SG ID
  source_security_group_id = # TODO: API ECS의 SG ID
}

resource "aws_security_group_rule" "api_to_rds_egress" {
  type            = # TODO: ingress / egress 지정
  from_port       = # TODO: db포트
  to_port         = # TODO: db포트
  protocol        = "tcp"

  security_group_id = # TODO: API ECS의 SG ID
  source_security_group_id = # TODO: RDS의 SG ID
}