resource "aws_security_group" "rds" {
  name   = "${var.name}-rds-sg"
  vpc_id = aws_vpc.main.id

  # aws_security_group.ecs_api_rds_client 에서 aws_security_group.rds의 sg_id를 참조
  # 반면, aws_security_group.rds에서도 aws_security_group.ecs_api_rds_client 의 sg_id를 참조 하게 되면 
  # cycle dependency 문제가 발생 하는데, 어떻게 해결 할 수 있을까?
  # ingress {
  #   from_port       = aws_db_instance.rds.port
  #   to_port         = aws_db_instance.rds.port
  #   protocol        = "tcp"
  #   security_groups = [aws_security_group.ecs_api_rds_client.id]
  # }

  tags = {
    Name = "${var.name}-rds-sg"
  }
}